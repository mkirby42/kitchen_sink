# Hosted Supabase → Project Settings → API
# Required to run the app, tests against the live project, and npm run seed:media.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-or-publishable-key

# Server-only. Required to start a therapist draft (create their login) and to
# email the "your draft is ready" link. The rest of the app runs without it.
# Never commit this or expose it to the browser. npm run apply:travis-white
# also needs it, plus SUPABASE_ACCESS_TOKEN (database write) or DATABASE_URL.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Public origin for canonical URLs. Defaults to the live Vercel host.
# SITE_URL=https://kitchen-sink-tau.vercel.app

# Server-only. Sends Join "Feedback for us" through Resend to the ops inbox.
# Never expose this to the browser. A verified RESEND_FROM is required for
# delivery beyond Resend's sandbox (onboarding@resend.dev → the account owner).
# RESEND_API_KEY=re_...
# RESEND_FROM=Kitchen Sink <feedback@yourdomain.com>
